{
  "name": "chartdown",
  "version": "0.4.0",
  "description": "Parser for ChartDown (spec 0.8), a plain-text notation for Nashville Number System charts: sections, bars, numbers, keys and notes for each instrument. Reads charts written for 0.3 to 0.7, gives the JSON form and the play order, and passes the official conformance suite.",
  "keywords": [
    "chartdown",
    "nashville-number-system",
    "chord-chart",
    "music",
    "parser"
  ],
  "homepage": "https://github.com/ChartDown/parser#readme",
  "bugs": {
    "url": "https://github.com/ChartDown/parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChartDown/parser.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-helpers.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
